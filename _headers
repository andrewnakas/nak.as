/*.glb
  Cache-Control: public, max-age=31536000, immutable
  Content-Type: model/gltf-binary

/sounds/*
  Cache-Control: public, max-age=31536000, immutable

/images/*
  Cache-Control: public, max-age=31536000, immutable

/posts/*
  Cache-Control: public, max-age=60

/game/pkg/*
  Cache-Control: public, max-age=300

/game/js/*
  Cache-Control: public, max-age=300

/game/assets/*
  Cache-Control: public, max-age=3600

/game/
  Cache-Control: public, max-age=300

/
  Cache-Control: public, max-age=300
